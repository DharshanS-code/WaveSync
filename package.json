{
  "name": "wavesync",
  "version": "1.0.0",
  "private": false,
  "description": "Mobile-first, peer-to-peer local music with host-coordinated playback.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/dev.mjs --static-only",
    "signal": "node backend/dev-server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-test.mjs",
    "lint": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "deploy:worker": "cd backend && npx --no-install wrangler deploy"
  },
  "keywords": [
    "pwa",
    "webrtc",
    "music",
    "sync",
    "cloudflare",
    "durable-objects"
  ],
  "devDependencies": {
    "playwright": "1.58.2",
    "ws": "^8.18.0"
  }
}
